# Settings for pipeline.http (VS Code REST Client) and PipelineExplorer.
# Copy to .env and fill in. .env is git-ignored: it holds your bearer token.
# Plain KEY=value, no quotes.

# Bearer token: open https://staging.cloud.unity.com/organizations/<ORG_ID>/dashboard,
# devtools > Network, copy the Authorization header of a call to
# staging.services.api.unity.com, WITHOUT the "Bearer " prefix. Lasts ~72 h.
UNITY_JWT=

# Your own staging org (numeric) and its Unity Cloud project (UUID).
ORG_ID=
PROJECT_ID=

# PUBLIC https git URL of the Unity project, and the branch to start with.
GIT_REPO_URL=
BRANCH=main

# staging or production.
PIPELINE_ENV=staging
# Sent with projectservice/start.
PIPELINE_REGION=America
# Windows64 | Linux64 | MacOS64 | iOS | Android
PIPELINE_PLATFORM=Windows64

# Fill these in from the responses as you go (pipeline.http says where).
WORKBENCH_ID=
ENVIRONMENT_ID=
